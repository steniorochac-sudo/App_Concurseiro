# ==============================================================================
# CONFIGURAÇÃO DE CHAVES E MODELOS GOOGLE GEMINI (2026)
# ==============================================================================

# Obtenha sua chave gratuita no Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Chaves reservas / secundárias opcionais (ativação de ROTAÇÃO AUTOMÁTICA)
# Se uma chave atingir limite de cota ou spending cap (HTTP 429), o sistema
# comuta automaticamente para a próxima chave sem interromper a execução:
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# Ou via lista separada por vírgulas:
# GEMINI_API_KEYS=chave1,chave2,chave3

# ==============================================================================
# SELEÇÃO DO MODELO GEMINI (Opções Modernas Homologadas)
# ==============================================================================
# - gemini-3.8-flash      -> (Recomendado) Mais recente, ultra-rápido, visão multimodal 300 DPI
# - gemini-3.7-flash      -> Raciocínio multimodal estendido e leitura de diagramas/tabelas
# - gemini-3.6-flash      -> Alta resiliência e estabilidade em lotes de alto volume
# - gemini-3.5-flash      -> Modelo de produção veloz e eficiente
# - gemini-3.5-flash-lite -> Baixa latência e consumo reduzido
# - gemini-flash-latest   -> Alias oficial do Google que sempre aponta para o Flash mais atual
# - gemini-pro-latest     -> Alias oficial do Google que sempre aponta para o Pro mais atual
# - gemini-3.1-pro-preview-> Análise jurídica e contábil aprofundada (Pro)
GEMINI_MODEL=gemini-3.8-flash

# Chave opcional do Groq (Fallback gratuito): https://console.groq.com/keys
GROQ_API_KEY=
